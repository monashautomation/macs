#!/usr/bin/env bash
# Resolve named secrets from secrets.conf via pluggable backend URIs.
# Usage: secrets <name> [conf_path]
# Schemes: keychain://service/account | op://... | bw://item/field | env://VAR | literal
set -euo pipefail

name="${1:-}"
# Default config lives at the repo root (next to scripts/), so callers
# can invoke secrets from any working directory.
conf="${2:-${SECRETS_CONF:-$(cd "$(dirname "$0")/.." && pwd)/secrets.conf}}"
if [ -z "$name" ]; then
  echo "usage: $(basename "$0") <name> [conf_path]" >&2
  exit 2
fi

[ -f "$conf" ] || { echo "secrets: config not found: $conf" >&2; exit 1; }

line=$(grep -E "^${name}=" "$conf" | head -1) || true
[ -n "$line" ] || { echo "secrets: no entry for '$name' in $conf" >&2; exit 1; }
uri="${line#*=}"

# All backends print WITHOUT a trailing newline (command substitution
# strips it) so consumers get identical bytes regardless of backend.
case "$uri" in
  keychain://*)
    rest="${uri#keychain://}"
    service="${rest%%/*}"
    account="${rest#*/}"
    out=$(security find-generic-password -s "$service" -a "$account" -w)
    printf '%s' "$out"
    ;;
  op://*)
    out=$(op read "$uri")
    printf '%s' "$out"
    ;;
  bw://*)
    rest="${uri#bw://}"
    item="${rest%%/*}"
    field="${rest#*/}"
    out=$(bw get "$field" "$item")
    printf '%s' "$out"
    ;;
  env://*)
    var="${uri#env://}"
    [ -n "${!var:-}" ] || { echo "secrets: env var '$var' not set" >&2; exit 1; }
    printf '%s' "${!var}"
    ;;
  *)
    printf '%s' "$uri"
    ;;
esac
