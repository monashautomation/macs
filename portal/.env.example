# Local development values. In production these come from OpenBao
# (apps/<name> path) through an ExternalSecret; never commit real values.
APP_URL=http://localhost:3000
APP_NAME=MACS
DATABASE_URL=postgresql://postgres:dev@localhost:5432/macs
# 32+ random characters: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Authentik OAuth2/OpenID provider for this app. Redirect URI:
#   <APP_URL>/api/auth/callback/authentik
# Scopes must include the "groups" scope mapping.
AUTHENTIK_ISSUER=https://auth.monashautomation.com/application/o/<slug>/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_LIBRARY_URL=https://auth.monashautomation.com/if/user/#/library

# Comma-separated Authentik group names.
ADMIN_GROUPS=
# Leave empty to let any signed-in Authentik user in.
MEMBER_GROUPS=

# {"caller-name":"<sha256 of its key>"}; see scripts/new-service-key.mjs
SERVICE_KEYS={}
LOG_LEVEL=info

# Clusters, limits, network policy. See config.example.yaml.
MACS_CONFIG=./config.dev.yaml
# VM console websocket relay (second listener; see README "Console").
CONSOLE_WS_PORT=3001
# CONSOLE_WS_URL=wss://macs.monashautomation.com/console-ws
SCHEDULER_INTERVAL_SECONDS=30
# Optional: also POST each notification here as JSON (e.g. the Discord bot). See README "Notifications".
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
# Proxmox API token secrets referenced from the config file as ${NAME}
RESEARCH_PVE_TOKEN=
HOMELAB_PVE_TOKEN=
